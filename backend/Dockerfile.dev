# ── Stage 1: Tooling ──────────────────────────────────────────
# Install cargo-watch and sqlx-cli once in a cached layer
FROM rust:slim AS tooling

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
    && cargo binstall -y cargo-watch \
    && cargo binstall -y sqlx-cli

# ── Stage 2: Dev Runtime ──────────────────────────────────────
# Slim image with only the pre-built tools copied in
FROM rust:slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-compiled tools from builder
COPY --from=tooling /usr/local/cargo/bin/cargo-watch /usr/local/cargo/bin/cargo-watch
COPY --from=tooling /usr/local/cargo/bin/sqlx /usr/local/cargo/bin/sqlx

WORKDIR /usr/src/app

# Source is bind-mounted at runtime via docker-compose volumes
CMD sqlx database create && sqlx migrate run && cargo watch -x "run --bin backend"
